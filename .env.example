# ============================================================
# VoiceAqar environment configuration
# Copy to `.env` and fill in real values before deploying.
# Required vars are marked [REQUIRED].
# ============================================================

# --- HTTP server ---
PORT=8000

# --- PostgreSQL (relational data + LangGraph checkpoints) ---
# [REQUIRED] Full connection string for the app and drizzle-kit.
# For the bundled docker-compose (host port 5433) this is usually:
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5433/<POSTGRES_DB>
DATABASE_URL=postgres://postgres:secretpassword@localhost:5433/realestate_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=realestate_db
POSTGRES_PORT=5433

# --- Qdrant (vector database for properties) ---
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333

# --- Redis (working/session memory) ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- Neo4j (user preferences / knowledge graph) ---
# [REQUIRED] NEO4J_PASSWORD and a reachable URI.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# --- Google Gemini ---
# [REQUIRED] The shared API key for Live voice, embeddings, STT and TTS.
GEMINI_API_KEY=your_gemini_api_key
# Pin the exact Gemini Live + family model IDs:
GEMINI_LIVE_MODEL=gemini-2.0-flash-live
GEMINI_LIVE_VOICE=Puck
# Model used to judge conversation quality (task success, relevance, etc.)
# Use an OpenRouter model ID here when LLM_PROVIDER=openrouter
# (e.g. google/gemini-2.5-flash), or a Groq model ID when LLM_PROVIDER=groq.
GEMINI_EVAL_MODEL=gemini-3.1-flash-preview
# Optional per-million-token pricing used to compute cost/call in Opik scores.
# Leave 0 to skip the cost_usd score (token counts are still reported).
GEMINI_LIVE_INPUT_PRICE_PER_MILLION=0
GEMINI_LIVE_OUTPUT_PRICE_PER_MILLION=0

# --- Optional LLM/STT/TTS providers (if not using Gemini) ---
# LLM_PROVIDER selects the model used by the text chat agent AND the
# conversation-quality judge. 'gemini' (default), 'openrouter' or 'groq'.
LLM_PROVIDER=gemini
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Active provider selection ---
# Embeddings: 'local' (on-device, needs a functional onnx backend) or 'gemini'
EMBEDDING_PROVIDER=local
VECTOR_DB_PROVIDER=qdrant
TTS_PROVIDER=gemini
STT_PROVIDER=gemini

# --- Google Calendar (appointment booking) ---
# Service account email + private key, and the calendar to book into.
# Share your company calendar with the service account email first.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
# Working hours & slot config for offered appointments
CALENDAR_TIMEZONE=Africa/Cairo
CALENDAR_WORK_START=10:00
CALENDAR_WORK_END=17:00
CALENDAR_APPOINTMENT_DURATION_MIN=30
CALENDAR_SLOTS_PER_OFFER=3

# --- Opik observability (optional) ---
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=voiceaqar

# --- Voice mode: 'live' | 'pipeline' | 'both' ---
VOICE_MODE=both

# --- Security / auth (recommended for production) ---
# Shared token required by /api/chat* in the `x-api-token` header (blank = open).
API_AUTH_TOKEN=
# Shared token required by all /ws/* connections via `?access_token=` (blank = open).
WSS_ACCESS_TOKEN=
# Used to verify Twilio call webhooks (blank = signature check skipped).
TWILIO_AUTH_TOKEN=

# --- Session retention (hours) before idle chat sessions expire ---
SESSION_TTL_HOURS=6